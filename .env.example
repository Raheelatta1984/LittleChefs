# ─── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite, WASM) that
# ships with the repo — perfect for local dev and demos, no Docker required.
#
# For production point at any hosted Postgres (Neon, Supabase, RDS, docker-compose):
# DATABASE_URL=postgres://chef:chef@localhost:5432/chefuniverse
# DATABASE_SSL=true

DB_DRIVER=pglite
PGLITE_DIR=server/.data/pglite
PORT=8787

# ─── AI onboarding (optional) ────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Without a key the importer still works using
# schema.org Recipe data and YouTube descriptions — it just can't read messy pages.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=25000

# ─── Import safety ───────────────────────────────────────────────────────────
IMPORT_TIMEOUT_MS=12000
IMPORT_MAX_BYTES=2500000
IMPORT_MAX_REDIRECTS=4
# Never enable in production — only for local fixture servers in tests.
IMPORT_ALLOW_PRIVATE_HOSTS=false

# ─── Sessions / uploads ──────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
UPLOADS_DIR=server/.data/uploads
UPLOAD_MAX_BYTES=4000000

# Comma-separated origins if you want to lock the API down. Empty = allow all.
# CORS_ORIGINS=https://chef-universe.vercel.app

# ─── Vercel deployment ───────────────────────────────────────────────────────
# vercel.json builds the static app + compiles this API into one catch-all
# function (api/[...path].js). WITHOUT that function every /api/* call 404s
# ("Something went wrong (404)") — never deploy the static build alone.
# Set DATABASE_URL (+ DATABASE_SSL=true) in Vercel for durable data; without
# it the API uses PGlite in /tmp, which Vercel wipes when instances recycle.
# OCR photo scanning needs no env vars (Tesseract + English data are bundled).
