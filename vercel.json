{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{dist-server/server/db/migrations/**,node_modules/@tesseract.js-data/eng/4.0.0/**}",
      "excludeFiles": "{node_modules/@tesseract.js-data/eng/4.0.0_best_int/**,node_modules/tesseract.js-core/tesseract-core-relaxedsimd*,node_modules/tesseract.js-core/tesseract-core-simd.js,node_modules/tesseract.js-core/tesseract-core-simd.wasm*,**/*.map}"
    }
  }
}
